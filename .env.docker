# ─────────────────────────────────────────────────────────────────────────────
# SecureMail-Frontend — FULL STACK (Docker network) mode
# Used by root docker-compose.yml via: env_file: ./SecureMail-Frontend/.env.docker
#
# NEXT_PUBLIC_API_URL is still http://localhost:3000 because the browser
# always accesses the backend via the host machine's localhost (port mapping),
# regardless of what Docker internal network the containers use.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000
