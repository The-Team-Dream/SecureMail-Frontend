# ─────────────────────────────────────────────────────────────────────────────
# SecureMail-Frontend — STANDALONE mode
# HOW TO USE:
#   cp .env.standalone.example .env.standalone
#   OR just run: ./setup.sh (Mac/Linux) | setup.bat (Windows)
#
# ⚠️  IMPORTANT: NEXT_PUBLIC_API_URL is baked into the JS bundle at BUILD TIME.
#     It is passed as a Docker build ARG — not read at runtime from this file.
#     The setup script will ask you for the backend URL and pass it correctly.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000
