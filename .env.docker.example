# ─────────────────────────────────────────────────────────────────────────────
# SecureMail-Frontend — FULL STACK (Docker network) mode
# HOW TO USE: cp .env.docker.example .env.docker
#             OR just run the root setup.sh / setup.bat
#
# NEXT_PUBLIC_API_URL is http://localhost:3000 because the browser
# always accesses the backend via the host machine's localhost,
# regardless of Docker's internal network.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000
