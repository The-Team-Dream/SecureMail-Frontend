# ─────────────────────────────────────────────────────────────────────────────
# SecureMail-Frontend — STANDALONE mode
# Use with: cd SecureMail-Frontend && docker compose up --build
#
# NEXT_PUBLIC_API_URL: Browser → Backend URL
# Since the frontend makes only browser-side API calls (client-side axios),
# this URL must be reachable from the user's browser, not inside Docker.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime vars (port binding)
PORT=3001
HOSTNAME=0.0.0.0

# NOTE: NEXT_PUBLIC_API_URL is baked into the JS bundle at build time (not here).
# It is passed as a Docker build ARG in docker-compose.yml.
# Set it here as a fallback reference only.
NEXT_PUBLIC_API_URL=http://localhost:3000
